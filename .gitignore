# ============================================================
# Environment Variables, Secrets & API Keys (CRITICAL)
# ============================================================
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
frontend/.env

# Allow sample/template env files
!.env.example
!backend/.env.example
!frontend/.env.example

# Security Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.id_ed25519
pgpass*
.pgpass

